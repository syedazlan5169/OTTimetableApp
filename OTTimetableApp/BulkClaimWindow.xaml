<Window x:Class="OTTimetableApp.BulkClaimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Generate Claims" Height="720" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top controls -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Calendar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="200"
                      ItemsSource="{Binding Calendars}"
                      DisplayMemberPath="Display"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding SelectedCalendarId}"
                      Margin="0,0,12,0"/>

            <TextBlock Text="Month:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="140"
                      ItemsSource="{Binding Months}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Month"
                      SelectedValue="{Binding SelectedMonth}"
                      Margin="0,0,12,0"/>

            <Button Content="Generate" Width="120" Margin="12,0,0,0" Click="Generate_Click"/>

            <CheckBox Content="All"
                      VerticalAlignment="Center"
                      Margin="12,0,0,0"
                      IsChecked="{Binding AllChecked}"/>
        </StackPanel>

        <!-- Employee list / results -->
        <DataGrid Grid.Row="1"
                  Margin="0,0,0,10"
                  ItemsSource="{Binding Employees}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="✔" Binding="{Binding IsChecked}" Width="45"/>
                <DataGridTextColumn Header="Employee" Binding="{Binding Name}" Width="220" IsReadOnly="True"/>
                <DataGridTextColumn Header="Total Claim (RM)" Binding="{Binding GrandTotal, StringFormat={}{0:N2}}" Width="150" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Total Hours Claim" Binding="{Binding TotalHoursOT, StringFormat={}{0:N2}}" Width="140" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bottom controls -->
        <StackPanel Grid.Row="2" Orientation="Vertical">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Catatan Lampiran E:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding CatatanLampiranE, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="Catatan Lampiran A:" VerticalAlignment="Top" Margin="0,2,6,0"/>
                <TextBox Grid.Column="4"
                         Text="{Binding CatatanLampiranA, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="40"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>

            <Button Content="Export to Excel (per employee)"
                    Width="220"
                    Height="35"
                    Click="ExportAll_Click"
                    HorizontalAlignment="Left"
                    FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
